{
  "name": "starpi",
  "version": "1.1.0",
  "private": true,
  "description": "Browser-native knowledge assistant: on-device WebGPU inference (WebLLM), retrieval over a Supabase Postgres knowledge base, and an optional Python ingestion backend.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/umutcantezgel-cpu/Starpi.git"
  },
  "bugs": {
    "url": "https://github.com/umutcantezgel-cpu/Starpi/issues"
  },
  "homepage": "https://www.starpi.app",
  "license": "MIT",
  "author": "umutcantezgel-cpu",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch --serve",
    "preview": "node scripts/serve.mjs --port 3000",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"tests/unit/*.test.mjs\"",
    "test:e2e": "playwright test",
    "verify:dist": "node scripts/verify-dist.mjs",
    "docs:sync": "node scripts/sync-diagrams.mjs",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && npm run verify:dist"
  },
  "keywords": [
    "webgpu",
    "webllm",
    "browser-inference",
    "on-device-ai",
    "supabase",
    "pgvector",
    "retrieval-augmented-generation",
    "privacy",
    "pwa"
  ],
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@mlc-ai/web-llm": "0.2.85",
    "@supabase/supabase-js": "2.117.0",
    "dompurify": "3.4.15",
    "lucide": "1.47.0",
    "marked": "18.0.14",
    "pdfjs-dist": "6.3.289"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "jsdom": "30.1.1",
    "mermaid": "12.0.0",
    "tailwindcss": "3.4.19",
    "typescript": "7.0.2"
  }
}
