<?xml version="1.0" encoding="UTF-8"?>
<!--
  Starpi Core (the local companion) as a launchd agent of your macOS account. install.sh writes it
  to ~/Library/LaunchAgents/app.starpi.companion.plist with the placeholders replaced (with
  sandbox-exec in front of node when you choose the sandbox). launchd starts it at login, restarts it
  after a crash (not after a clean stop) and keeps its log in ~/Library/Logs/starpi-companion.
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/app.starpi.companion.plist
    launchctl print gui/$(id -u)/app.starpi.companion
    launchctl bootout gui/$(id -u)/app.starpi.companion
  Folders, configuration and the vault's key are the companion's defaults for your account
  (~/Library/Application Support/starpi-companion).
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>app.starpi.companion</string>
  <key>ProgramArguments</key>
  <array>
@PROGRAM_ARGUMENTS@
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ExitTimeOut</key>
  <integer>30</integer>
  <key>ProcessType</key>
  <string>Standard</string>
  <key>Umask</key>
  <integer>63</integer>
  <key>WorkingDirectory</key>
  <string>@APP@</string>
  <key>StandardOutPath</key>
  <string>@LOG_DIR@/companion.log</string>
  <key>StandardErrorPath</key>
  <string>@LOG_DIR@/companion.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>NODE_ENV</key>
    <string>production</string>
  </dict>
</dict>
</plist>
