{
  "name": "@starpi/core",
  "version": "2.1.0",
  "description": "Deterministic source check for RAG answers (a hallucination check without a second model: facts, negations, and names and values in the wrong place), verifiable answer receipts (starpi.receipt/v2: Merkle tree, optional Ed25519 or ES256 signature) and a CLI that writes SARIF for CI, with the text extraction, chunking and BM25 of Starpi. No dependencies.",
  "type": "module",
  "license": "MIT",
  "author": "Umutcan Emre Tezgel (https://github.com/umutcantezgel-cpu)",
  "homepage": "https://github.com/umutcantezgel-cpu/Starpi/tree/main/packages/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/umutcantezgel-cpu/Starpi.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/umutcantezgel-cpu/Starpi/issues"
  },
  "keywords": [
    "rag",
    "retrieval-augmented-generation",
    "deterministic-verification",
    "hallucination-check",
    "rag-receipts",
    "receipts",
    "citations",
    "grounding",
    "faithfulness",
    "provenance",
    "bm25",
    "sarif",
    "merkle-tree",
    "webgpu",
    "zero-dependencies"
  ],
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "starpi-gate": "dist/gate.js",
    "starpi-ground": "dist/ground.js",
    "starpi-verify-receipt": "dist/verify-receipt.js"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "engines": {
    "node": ">=22.13"
  },
  "peerDependencies": {
    "pdfjs-dist": "^6.3.289"
  },
  "peerDependenciesMeta": {
    "pdfjs-dist": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "prepack": "node ../../scripts/build-core.mjs"
  }
}
