{
  "description": "Shared request-validation vectors for POST /api/chat/nvidia. tests/unit/nvidia-proxy.test.mjs and backend/test_nvidia.py run every case; a value {\"$repeat\": [text, n]} stands for text repeated n times.",
  "vectors": [
    {"name":"a minimal request gets the default max_tokens and the fixed upstream fields of the model","body":{"model":"nvidia/nemotron-3.5-lightning-30b-a3b","messages":[{"role":"user","content":"Hi"}]},"expect":{"upstream":{"chat_template_kwargs":{"enable_thinking":false},"model":"nvidia/nemotron-3.5-lightning-30b-a3b","messages":[{"role":"user","content":"Hi"}],"max_tokens":1024,"stream":true}}},
    {"name":"a full conversation keeps temperature and top_p","body":{"model":"nvidia/nemotron-3-super-120b-a12b","messages":[{"role":"system","content":"Answer briefly."},{"role":"user","content":"What is 2 + 2?"},{"role":"assistant","content":"4"},{"role":"user","content":"And 3 + 3?"}],"max_tokens":100,"temperature":0.2,"top_p":0.9},"expect":{"upstream":{"model":"nvidia/nemotron-3-super-120b-a12b","messages":[{"role":"system","content":"Answer briefly."},{"role":"user","content":"What is 2 + 2?"},{"role":"assistant","content":"4"},{"role":"user","content":"And 3 + 3?"}],"max_tokens":100,"stream":true,"temperature":0.2,"top_p":0.9}}},
    {"name":"max_tokens above the model cap is clamped to it","body":{"model":"nvidia/nemotron-3.5-lightning-30b-a3b","messages":[{"role":"user","content":"Hi"}],"max_tokens":100000},"expect":{"upstream":{"chat_template_kwargs":{"enable_thinking":false},"model":"nvidia/nemotron-3.5-lightning-30b-a3b","messages":[{"role":"user","content":"Hi"}],"max_tokens":2048,"stream":true}}},
    {"name":"a huge integer max_tokens is clamped as well","body":{"model":"nvidia/nemotron-3-super-120b-a12b","messages":[{"role":"user","content":"Hi"}],"max_tokens":1000000000000000000000000000000},"expect":{"upstream":{"model":"nvidia/nemotron-3-super-120b-a12b","messages":[{"role":"user","content":"Hi"}],"max_tokens":4096,"stream":true}}},
    {"name":"an integral float max_tokens counts as an integer","body":{"model":"nvidia/nemotron-3.5-lightning-30b-a3b","messages":[{"role":"user","content":"Hi"}],"max_tokens":64.0},"expect":{"upstream":{"chat_template_kwargs":{"enable_thinking":false},"model":"nvidia/nemotron-3.5-lightning-30b-a3b","messages":[{"role":"user","content":"Hi"}],"max_tokens":64,"stream":true}}},
    {"name":"every other field is dropped and stream is always true","body":{"model":"nvidia/nemotron-3.5-lightning-30b-a3b","messages":[{"role":"user","content":"Hi","name":"alice"}],"stream":false,"tools":[{"type":"function"}],"tool_choice":"auto","n":3,"stop":["x"],"seed":1,"user":"u","logprobs":true,"response_format":{"type":"json_object"},"stream_options":{"include_usage":true},"chat_template_kwargs":{"enable_thinking":true}},"expect":{"upstream":{"chat_template_kwargs":{"enable_thinking":false},"model":"nvidia/nemotron-3.5-lightning-30b-a3b","messages":[{"role":"user","content":"Hi"}],"max_tokens":1024,"stream":true}}},
    {"name":"null optional fields count as absent","body":{"model":"nvidia/nemotron-3.5-lightning-30b-a3b","messages":[{"role":"user","content":"Hi"}],"max_tokens":null,"temperature":null,"top_p":null},"expect":{"upstream":{"chat_template_kwargs":{"enable_thinking":false},"model":"nvidia/nemotron-3.5-lightning-30b-a3b","messages":[{"role":"user","content":"Hi"}],"max_tokens":1024,"stream":true}}},
    {"name":"temperature 0 and top_p 1 are allowed","body":{"model":"nvidia/nemotron-3.5-lightning-30b-a3b","messages":[{"role":"user","content":"Hi"}],"temperature":0,"top_p":1},"expect":{"upstream":{"chat_template_kwargs":{"enable_thinking":false},"model":"nvidia/nemotron-3.5-lightning-30b-a3b","messages":[{"role":"user","content":"Hi"}],"max_tokens":1024,"stream":true,"temperature":0,"top_p":1}}},
    {"name":"temperature 2 is allowed","body":{"model":"nvidia/nemotron-3.5-lightning-30b-a3b","messages":[{"role":"user","content":"Hi"}],"temperature":2},"expect":{"upstream":{"chat_template_kwargs":{"enable_thinking":false},"model":"nvidia/nemotron-3.5-lightning-30b-a3b","messages":[{"role":"user","content":"Hi"}],"max_tokens":1024,"stream":true,"temperature":2}}},
    {"name":"a lone surrogate in content is passed on","body":{"model":"nvidia/nemotron-3.5-lightning-30b-a3b","messages":[{"role":"user","content":"\ud800"}]},"expect":{"upstream":{"chat_template_kwargs":{"enable_thinking":false},"model":"nvidia/nemotron-3.5-lightning-30b-a3b","messages":[{"role":"user","content":"\ud800"}],"max_tokens":1024,"stream":true}}},
    {"name":"only ASCII whitespace makes the last message blank","body":{"model":"nvidia/nemotron-3.5-lightning-30b-a3b","messages":[{"role":"user","content":"\u00a0"}]},"expect":{"upstream":{"chat_template_kwargs":{"enable_thinking":false},"model":"nvidia/nemotron-3.5-lightning-30b-a3b","messages":[{"role":"user","content":"\u00a0"}],"max_tokens":1024,"stream":true}}},
    {"name":"a message of exactly maxMessageChars UTF-16 units is allowed","body":{"model":"nvidia/nemotron-3.5-lightning-30b-a3b","messages":[{"role":"user","content":{"$repeat":["😀",12000]}}]},"expect":{"upstream":{"chat_template_kwargs":{"enable_thinking":false},"model":"nvidia/nemotron-3.5-lightning-30b-a3b","messages":[{"role":"user","content":{"$repeat":["😀",12000]}}],"max_tokens":1024,"stream":true}}},
    {"name":"40 messages are allowed","body":{"model":"nvidia/nemotron-3.5-lightning-30b-a3b","messages":[{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"}]},"expect":{"upstream":{"chat_template_kwargs":{"enable_thinking":false},"model":"nvidia/nemotron-3.5-lightning-30b-a3b","messages":[{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"}],"max_tokens":1024,"stream":true}}},
    {"name":"model is required","body":{"messages":[{"role":"user","content":"Hi"}]},"expect":{"error":"invalid_field","field":"model"}},
    {"name":"model must be a string","body":{"model":7,"messages":[{"role":"user","content":"Hi"}]},"expect":{"error":"invalid_field","field":"model"}},
    {"name":"a model outside the allowlist is refused","body":{"model":"evil/model","messages":[{"role":"user","content":"Hi"}]},"expect":{"error":"model_not_allowed"}},
    {"name":"model ids are case sensitive","body":{"model":"NVIDIA/NEMOTRON-3.5-LIGHTNING-30B-A3B","messages":[{"role":"user","content":"Hi"}]},"expect":{"error":"model_not_allowed"}},
    {"name":"the model is checked before the messages","body":{"model":"evil/model","messages":"x"},"expect":{"error":"model_not_allowed"}},
    {"name":"messages are required","body":{"model":"nvidia/nemotron-3.5-lightning-30b-a3b"},"expect":{"error":"invalid_field","field":"messages"}},
    {"name":"messages must be an array","body":{"model":"nvidia/nemotron-3.5-lightning-30b-a3b","messages":{"role":"user","content":"Hi"}},"expect":{"error":"invalid_field","field":"messages"}},
    {"name":"messages must not be empty","body":{"model":"nvidia/nemotron-3.5-lightning-30b-a3b","messages":[],"max_tokens":0},"expect":{"error":"invalid_field","field":"messages"}},
    {"name":"more than maxMessages messages are refused","body":{"model":"nvidia/nemotron-3.5-lightning-30b-a3b","messages":[{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"},{"role":"user","content":"x"}]},"expect":{"error":"invalid_field","field":"messages"}},
    {"name":"each message must be an object","body":{"model":"nvidia/nemotron-3.5-lightning-30b-a3b","messages":["Hi"]},"expect":{"error":"invalid_field","field":"messages"}},
    {"name":"roles are limited to system, user and assistant","body":{"model":"nvidia/nemotron-3.5-lightning-30b-a3b","messages":[{"role":"tool","content":"x"},{"role":"user","content":"Hi"}]},"expect":{"error":"invalid_field","field":"messages"}},
    {"name":"a system message is allowed only first","body":{"model":"nvidia/nemotron-3.5-lightning-30b-a3b","messages":[{"role":"user","content":"Hi"},{"role":"system","content":"x"},{"role":"user","content":"Hi"}]},"expect":{"error":"invalid_field","field":"messages"}},
    {"name":"multimodal content arrays are refused","body":{"model":"nvidia/nemotron-3.5-lightning-30b-a3b","messages":[{"role":"user","content":[{"type":"text","text":"Hi"}]}]},"expect":{"error":"invalid_field","field":"messages"}},
    {"name":"content must be a string","body":{"model":"nvidia/nemotron-3.5-lightning-30b-a3b","messages":[{"role":"user","content":42}]},"expect":{"error":"invalid_field","field":"messages"}},
    {"name":"the last message must come from the user","body":{"model":"nvidia/nemotron-3.5-lightning-30b-a3b","messages":[{"role":"user","content":"Hi"},{"role":"assistant","content":"Hello"}]},"expect":{"error":"invalid_field","field":"messages"}},
    {"name":"the last message must not be blank","body":{"model":"nvidia/nemotron-3.5-lightning-30b-a3b","messages":[{"role":"user","content":" \t\n\r\f\u000b"}]},"expect":{"error":"invalid_field","field":"messages"}},
    {"name":"a message above maxMessageChars is refused","body":{"model":"nvidia/nemotron-3.5-lightning-30b-a3b","messages":[{"role":"user","content":{"$repeat":["x",24001]}}]},"expect":{"error":"invalid_field","field":"messages"}},
    {"name":"length counts UTF-16 units, so 12001 emoji are too long","body":{"model":"nvidia/nemotron-3.5-lightning-30b-a3b","messages":[{"role":"user","content":{"$repeat":["😀",12001]}}]},"expect":{"error":"invalid_field","field":"messages"}},
    {"name":"all messages together may not exceed maxTotalChars","body":{"model":"nvidia/nemotron-3.5-lightning-30b-a3b","messages":[{"role":"user","content":{"$repeat":["x",21334]}},{"role":"assistant","content":{"$repeat":["x",21334]}},{"role":"user","content":{"$repeat":["x",21334]}}]},"expect":{"error":"invalid_field","field":"messages"}},
    {"name":"max_tokens 0 is refused","body":{"model":"nvidia/nemotron-3.5-lightning-30b-a3b","messages":[{"role":"user","content":"Hi"}],"max_tokens":0},"expect":{"error":"invalid_field","field":"max_tokens"}},
    {"name":"negative max_tokens is refused","body":{"model":"nvidia/nemotron-3.5-lightning-30b-a3b","messages":[{"role":"user","content":"Hi"}],"max_tokens":-5},"expect":{"error":"invalid_field","field":"max_tokens"}},
    {"name":"fractional max_tokens is refused","body":{"model":"nvidia/nemotron-3.5-lightning-30b-a3b","messages":[{"role":"user","content":"Hi"}],"max_tokens":1.5},"expect":{"error":"invalid_field","field":"max_tokens"}},
    {"name":"boolean max_tokens is refused","body":{"model":"nvidia/nemotron-3.5-lightning-30b-a3b","messages":[{"role":"user","content":"Hi"}],"max_tokens":true},"expect":{"error":"invalid_field","field":"max_tokens"}},
    {"name":"string max_tokens is refused","body":{"model":"nvidia/nemotron-3.5-lightning-30b-a3b","messages":[{"role":"user","content":"Hi"}],"max_tokens":"100"},"expect":{"error":"invalid_field","field":"max_tokens"}},
    {"name":"an infinite max_tokens is refused","body":{"model":"nvidia/nemotron-3.5-lightning-30b-a3b","messages":[{"role":"user","content":"Hi"}],"max_tokens":1e400},"expect":{"error":"invalid_field","field":"max_tokens"}},
    {"name":"temperature above 2 is refused","body":{"model":"nvidia/nemotron-3.5-lightning-30b-a3b","messages":[{"role":"user","content":"Hi"}],"temperature":2.5},"expect":{"error":"invalid_field","field":"temperature"}},
    {"name":"negative temperature is refused","body":{"model":"nvidia/nemotron-3.5-lightning-30b-a3b","messages":[{"role":"user","content":"Hi"}],"temperature":-0.1},"expect":{"error":"invalid_field","field":"temperature"}},
    {"name":"boolean temperature is refused","body":{"model":"nvidia/nemotron-3.5-lightning-30b-a3b","messages":[{"role":"user","content":"Hi"}],"temperature":false},"expect":{"error":"invalid_field","field":"temperature"}},
    {"name":"string temperature is refused","body":{"model":"nvidia/nemotron-3.5-lightning-30b-a3b","messages":[{"role":"user","content":"Hi"}],"temperature":"0.5"},"expect":{"error":"invalid_field","field":"temperature"}},
    {"name":"top_p 0 is refused","body":{"model":"nvidia/nemotron-3.5-lightning-30b-a3b","messages":[{"role":"user","content":"Hi"}],"top_p":0},"expect":{"error":"invalid_field","field":"top_p"}},
    {"name":"top_p above 1 is refused","body":{"model":"nvidia/nemotron-3.5-lightning-30b-a3b","messages":[{"role":"user","content":"Hi"}],"top_p":1.5},"expect":{"error":"invalid_field","field":"top_p"}}
  ]
}
