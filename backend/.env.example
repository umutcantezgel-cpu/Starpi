# ==============================================================================
# Brain backend configuration. Copy to backend/.env and fill in real values.
# Placeholders only; never commit the real .env.
# Values already set in the process environment take precedence over this file.
# ==============================================================================

# --- Supabase ------------------------------------------------------------------
# Leave both empty to run with in-memory storage (offline development).
# Format: SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_URL=
# The backend writes with the SERVICE ROLE key, which bypasses row level security.
# It is a server-only secret: never expose it to browsers, the PWA, or client code.
# The browser app uses the anon key with anonymous sign-ins and RLS instead.
# The anon key is not read by the backend.
SUPABASE_SERVICE_ROLE_KEY=

# --- Chat model (OpenAI-compatible endpoint: vLLM, MLX, llama.cpp server, ...) ---
LLM_BASE_URL=http://127.0.0.1:8000/v1
# Use EMPTY when the endpoint needs no key.
LLM_API_KEY=EMPTY
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# Optional hosted key pools, comma separated. Tried before LLM_BASE_URL when set.
GEMINI_API_KEYS=
OPENROUTER_API_KEYS=

# --- Embeddings (OpenAI-compatible /embeddings, 1536 dimensions) ----------------
# If this endpoint is unavailable, sections are stored without embeddings.
EMBEDDING_BASE_URL=http://127.0.0.1:8000/v1
EMBEDDING_API_KEY=EMPTY
EMBEDDING_MODEL=text-embedding-3-small

# --- HTTP API server --------------------------------------------------------------
BRAIN_SERVER_PORT=9200
# Keep 127.0.0.1 and put a TLS reverse proxy in front for remote access.
# Any non-loopback address requires BRAIN_API_TOKEN; the server refuses to start otherwise.
BRAIN_SERVER_HOST=127.0.0.1
# Bearer token required on /api/brain/* when set. Generate with: openssl rand -hex 32
BRAIN_API_TOKEN=
# Browser origins allowed via CORS, comma separated.
BRAIN_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://www.starpi.app,https://starpi.app
# Maximum request body size in bytes.
BRAIN_MAX_BODY_BYTES=1048576
# DEBUG, INFO, WARNING or ERROR.
BRAIN_LOG_LEVEL=INFO
