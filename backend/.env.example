# ==============================================================================
# Enterprise Brain: Environment Configuration
# ==============================================================================

# 1. Supabase Credentials (Optional for local testing, required for live cloud DB)
# Erstellen Sie ein kostenloses Projekt auf https://supabase.com
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# 2. Private Cloud GPU / Local Inferenz
# Standardmäßig auf den lokalen Port 8000 oder Ihre RunPod/Hetzner vLLM URL setzen
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_API_KEY=EMPTY
LLM_MODEL=/Users/umurey/LocalModels/Qwen3.8-27B-Uncensored-MLX/4-bit

# 3. Vector Embeddings
EMBEDDING_BASE_URL=http://127.0.0.1:8000/v1
EMBEDDING_API_KEY=EMPTY
EMBEDDING_MODEL=text-embedding-3-small

# 4. Enterprise Brain Server Port
BRAIN_SERVER_PORT=9200
BRAIN_SERVER_HOST=0.0.0.0
