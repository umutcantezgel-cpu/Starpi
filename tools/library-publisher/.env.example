# ==============================================================================
# Library publisher configuration. Copy to tools/library-publisher/.env and fill in real values.
# Placeholders only; never commit the real .env.
# Values already set in the process environment take precedence over this file.
# ==============================================================================

# --- Supabase ------------------------------------------------------------------
# Format: SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_URL=
# The publisher writes with the SERVICE ROLE key, which bypasses row level security.
# It is a server-only secret: never expose it to browsers, the PWA, or client code.
# The browser app uses the anon key with anonymous sign-ins and RLS instead.
SUPABASE_SERVICE_ROLE_KEY=

# --- Embedding model ------------------------------------------------------------
# Directory with tokenizer.json and onnx/model_quantized.onnx of multilingual-e5-small, filled by
# `python -m publisher fetch-model`. Default: tools/library-publisher/models/multilingual-e5-small
PUBLISHER_MODEL_DIR=

# --- Optional chat model (publish --structure only) --------------------------------
# Chat Completions-compatible endpoint (/v1/chat/completions: vLLM, llama.cpp server, Ollama, ...).
LLM_BASE_URL=http://127.0.0.1:8000/v1
# Use EMPTY when the endpoint needs no key.
LLM_API_KEY=EMPTY
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
